{
  "name": "strands-booking-auth",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun src/agent.ts",
    "mcp-server": "bun src/mcp-server/server.ts",
    "dev:bedrock": "bun src/agent.ts --provider bedrock",
    "infra:start": "docker compose up -d",
    "infra:stop": "docker compose down",
    "infra:status": "docker compose ps",
    "infra:logs": "docker compose logs --follow langfuse-web langfuse-worker",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/minimist": "^1.2.5",
    "@types/node": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@langfuse/otel": "^5.11.1",
    "@langfuse/tracing": "^5.11.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@strands-agents/sdk": "^1.19.0",
    "minimist": "^1.2.8",
    "openai": "^6.49.0",
    "otel-bun": "^0.3.0",
    "zod": "^4.6.5"
  }
}
