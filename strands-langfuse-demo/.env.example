# LM Studio (or any OpenAI-compatible local server)
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL_ID=

# AWS Bedrock (uses the standard AWS credential chain)
AWS_REGION=ap-southeast-2
BEDROCK_MODEL_ID=

# Langfuse SDK: local stack from docker-compose.yml (dev defaults, local use only)
LANGFUSE_PUBLIC_KEY=pk-lf-local
LANGFUSE_SECRET_KEY=sk-lf-local
LANGFUSE_BASE_URL=http://localhost:3000

# Colima/Docker with < 16 GiB: skip Langfuse init scripts (crash-loop). Sign up manually at http://localhost:3000 and create API keys.
NEXT_PUBLIC_LANGFUSE_RUN_NEXT_INIT=false
LANGFUSE_LOCAL_USER=dev@local.dev
LANGFUSE_LOCAL_PASSWORD=password

LANGFUSE_TRACING_ENVIRONMENT=development
